# ==============================================================================
# Stremio All-in-One (tsaridas/stremio-docker) — Variables d'environnement
# Copier vers .env (chmod 600 .env) — NE JAMAIS COMMITTER .env
# ==============================================================================

# Port HTTP exposé sur l'hôte / le LXC (Zoraxy ou NPM vient pointer dessus)
STREMIO_PORT=8080

# Indispensable pour que Stremio Web communique proprement avec stremio-server
NO_CORS=1
AUTO_SERVER_URL=1

# Laisser vide en accès LAN pur (AUTO_SERVER_URL s'adapte à l'URL du navigateur),
# OU définir votre URL HTTPS publique derrière Zoraxy / Nginx Proxy Manager :
# Ex: SERVER_URL=https://stremio.example.com/
SERVER_URL=

# HTTP Basic Auth intégrée (protège l'UI & les endpoints API sans casser les
# probes HLS /manifest.json, /localStorage.json, /server_url.env, /{hash}/-1)
USERNAME=admin
PASSWORD=replace-with-stremio-password

# Désactive SSDP/casting dans les environnements LXC / reverse proxy
CASTING_DISABLED=1

# Sonde VA-API au démarrage (Intel / AMD sur hôte Linux)
VAAPI_PREFLIGHT=1
# LIBVA_DRIVER_NAME=iHD
