# ==============================================================================
# Authentification & Sécurité Tailscale Serve
# ==============================================================================
# IMPORTANT: Doit impérativement être à "false" en production (Phase 2).
# "true" autorise uniquement localhost (127.0.0.1 / ::1) en Phase 1 locale.
DEV_AUTH_BYPASS=false

# Liste d'emails Tailscale autorisés séparés par des virgules (ex: user@domain.com)
ALLOWED_TAILSCALE_USERS=user@example.com
# Compte administrateur principal protégé contre la suppression/rétrogradation dans le module Utilisateurs
PROTECTED_OWNER_USERNAME=admin

# ==============================================================================
# Chemins de configuration
# ==============================================================================
SERVICES_CONFIG_PATH=../services.yaml
# Laisser vide pour auto-détection (frontend/dist en dev ou /app/static en Docker)
STATIC_DIR=

# ==============================================================================
# Proxmox VE API (Token restreint sans privilèges shell)
# ==============================================================================
PVE_HOST=https://192.168.1.10:8006
PVE_NODE=pve
PVE_TOKEN_ID=root@pam!pve-panel
PVE_TOKEN_SECRET=replace-with-pve-token-secret
PVE_VERIFY_SSL=false
# ID du conteneur LXC hébergeant ce panel (protégé contre l'arrêt accidentel)
PANEL_SELF_VMID=116
# Sous-dossier optionnel du pool MergerFS sous HOST_MNT_ROOT (laisser vide pour auto-détection)
MERGERFS_POOL_SUBPATH=

# ==============================================================================
# Services Médias & Téléchargements (clés et identifiants pour les widgets)
# ==============================================================================
JELLYFIN_URL=http://192.168.1.26:8096
JELLYFIN_API_KEY=replace-with-jellyfin-api-key

JELLYSEERR_URL=http://192.168.1.31:5055
JELLYSEERR_API_KEY=replace-with-jellyseerr-api-key

PLEX_URL=http://192.168.1.30:32400
PLEX_TOKEN=replace-with-plex-token

STREMIO_URL=http://192.168.1.33:8080
STREMIO_USERNAME=admin
STREMIO_PASSWORD=replace-with-stremio-password

RADARR_URL=http://192.168.1.27:7878
RADARR_API_KEY=replace-with-radarr-api-key

SONARR_URL=http://192.168.1.28:8989
SONARR_API_KEY=replace-with-sonarr-api-key

PROWLARR_URL=http://192.168.1.29:9696
PROWLARR_API_KEY=replace-with-prowlarr-api-key

QBIT_URL=http://192.168.1.32:8090
QBIT_USERNAME=admin
QBIT_PASSWORD=replace-with-qbittorrent-password
